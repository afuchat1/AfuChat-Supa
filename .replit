PESAPAL_ENV = "production"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS AAB Build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Preview Build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "EAS AAB Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_NO_VCS=1 EXPO_TOKEN=$EXPO_TOKEN npx --yes eas-cli@latest build --platform android --profile production --non-interactive --no-wait"

[[workflows.workflow]]
name = "EAS Preview Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_NO_VCS=1 EXPO_TOKEN=$EXPO_TOKEN npx --yes eas-cli@latest build --platform android --profile preview --non-interactive --no-wait"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EXPO_OFFLINE=1 EXPO_NO_LAZY=1 pnpm exec expo export -p web --output-dir dist && PORT=5000 node scripts/serve-static-web.mjs"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 80


[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "static"
build = ["pnpm", "--dir", "artifacts/mobile", "exec", "expo", "export", "-p", "web"]
publicDir = "artifacts/mobile/dist"
