modules = ["bash", "nix", "python-base-3.13", "postgresql-16", "nodejs-22"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0"]
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPABASE_PROJECT_REF = "poijhidfekwfthyksatp"
EXPO_PUBLIC_SUPABASE_URL = "https://poijhidfekwfthyksatp.supabase.co"
PORT = "3000"
SUPABASE_URL = "https://poijhidfekwfthyksatp.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBvaWpoaWRmZWt3ZnRoeWtzYXRwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5MDcwNDksImV4cCI6MjEwNTQ4MzA0OX0.sEcHL19jvnPkFDUmYRazp5ntwFyJd_mE4Nh--lbaVNE"
CLOUDFLARE_ACCOUNT_ID = "42e79186125e8ff83e51f15816e074de"
R2_BUCKET = "afuchat-media"
R2_PUBLIC_BASE_URL = "https://cdn.afuchat.com"
R2_DEV_PUBLIC_URL = "https://pub-2e81c468eb99436690ca6da9f89191ce.r2.dev"
R2_S3_ENDPOINT = "https://42e79186125e8ff83e51f15816e074de.r2.cloudflarestorage.com"
PESAPAL_ENV = "production"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Go"

[[workflows.workflow]]
name = "EAS AAB Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_NO_VCS=1 EXPO_TOKEN=$EXPO_ACCESS_TOKEN npx --yes eas-cli@latest build --platform android --profile production --non-interactive --no-wait"

[[workflows.workflow]]
name = "EAS Preview Build"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_NO_VCS=1 EXPO_TOKEN=$EXPO_ACCESS_TOKEN npx --yes eas-cli@latest build --platform android --profile preview --non-interactive --no-wait"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && pnpm run build:web && PORT=5000 node scripts/serve-static-web.mjs"
waitForPort = 5000

[[workflows.workflow]]
name = "Expo Go"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN:8000 EXPO_NO_REDIRECT_PAGE=1 NODE_OPTIONS=--max-old-space-size=4096 node scripts/start-expo-go.mjs"
waitForPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 21380
externalPort = 3000


[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "autoscale"
build = ["pnpm", "--dir", "artifacts/mobile", "exec", "expo", "export", "-p", "web"]
publicDir = "artifacts/mobile/dist"
run = ["node", "artifacts/mobile/scripts/serve-static-web.mjs"]
