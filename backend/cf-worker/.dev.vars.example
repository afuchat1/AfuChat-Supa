# Rename this file to .dev.vars for local wrangler dev (gitignored)
# These values are only needed for local development.
# In production, set secrets via: wrangler secret put <NAME>

# Supabase — get from https://supabase.com/dashboard/project/poijhidfekwfthyksatp/settings/api
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT — must match the value used by the Express API server
JWT_SECRET=your_jwt_secret_here

# Cloudflare R2 — get from Cloudflare dashboard → R2 → Manage API tokens
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Optional: set to your custom CDN domain once configured on R2
# R2_PUBLIC_URL=https://img.afuchat.com
