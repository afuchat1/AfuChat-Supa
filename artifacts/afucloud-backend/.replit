modules = ["nodejs-22", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SUPABASE_DB_HOST = "aws-1-eu-west-1.pooler.supabase.com"
SUPABASE_DB_NAME = "postgres"
SUPABASE_DB_PORT = "5432"
SUPABASE_DB_USER = "postgres.poijhidfekwfthyksatp"
SUPABASE_PROJECT_ID = "poijhidfekwfthyksatp"
