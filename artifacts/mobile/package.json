{
  "name": "@workspace/mobile",
  "version": "0.0.5",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi; EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=4096 pnpm exec expo start --go --tunnel --port 8000",
    "build:web": "EXPO_OFFLINE=1 EXPO_NO_LAZY=1 expo export -p web --clear --output-dir dist && node scripts/prepare-static-web.mjs",
    "build:apk": "bash scripts/eas-build.sh",
    "audit:i18n": "node scripts/audit-localization.js",
    "audit:i18n:strict": "node scripts/audit-localization.js --strict-literals",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web:cloudflare": "pnpm run build:web && mkdir -p dist/.well-known && cp well-known/assetlinks.json dist/.well-known/assetlinks.json && cp well-known/apple-app-site-association dist/.well-known/apple-app-site-association && printf '/.well-known/assetlinks.json\\n  Content-Type: application/json\\n  Cache-Control: public, max-age=300\\n\\n/.well-known/apple-app-site-association\\n  Content-Type: application/json\\n  Cache-Control: public, max-age=300\\n\\n/*.html\\n  Cache-Control: no-cache, no-store, must-revalidate\\n\\n/*/index.html\\n  Cache-Control: no-cache, no-store, must-revalidate\\n\\n/_expo/static/js/*\\n  Cache-Control: public, max-age=31536000, immutable\\n' > dist/_headers"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "58.1.19",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native/metro-config": "0.88.1",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.105.3",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ungap/structured-clone": "^1.4.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "create-launch": "^0.4.1",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "typescript": "~6.0.3",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@afuchat1/engagera": "^0.1.5",
    "@expo/metro-runtime": "~58.0.17",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-community/netinfo": "~12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.118.0",
    "@types/qrcode": "^1.5.6",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-contacts": "~58.0.10",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-keep-awake": "^58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-media-library": "~58.0.13",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.15",
    "expo-task-manager": "~58.0.13",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "libphonenumber-js": "^1.13.15",
    "qrcode": "^1.5.4",
    "react-native-compressor": "^1.6.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-pager-view": "9.0.7",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webrtc": "124.0.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "rn-emoji-keyboard": "^1.7.0",
    "expo": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.1"
  }
}
