{
  "name": "@workspace/mobile",
  "version": "0.0.5",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av",
          "react-native-webrtc"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_OFFLINE=1 NODE_OPTIONS=--max-old-space-size=4096 pnpm exec expo start --go --tunnel --port 8000",
    "build:web": "EXPO_OFFLINE=1 EXPO_NO_LAZY=1 expo export -p web --output-dir dist && node scripts/prepare-static-web.mjs",
    "build:apk": "bash scripts/eas-build.sh",
    "audit:i18n": "node scripts/audit-localization.js",
    "audit:i18n:strict": "node scripts/audit-localization.js --strict-literals",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/cli": "57.0.24",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "^19.2.7",
    "@ungap/structured-clone": "^1.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
